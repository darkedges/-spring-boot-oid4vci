{
  "realm": "risk-e-demo",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "risk-e-hr",
      "secret": "showcase-client-only",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:43194/login/oauth2/code/hr"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"bank-hr\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "hr.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "HR",
      "email": "hr@risk-e.example.test",
      "credentials": [
        {
          "type": "password",
          "value": "showcase-local-only",
          "temporary": false
        }
      ]
    }
  ]
}