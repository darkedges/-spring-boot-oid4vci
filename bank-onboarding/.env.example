# Loaded automatically by every make task. Existing shell variables take priority.
# Literal KEY=value or KEY='value'; full-line comments only. No variable expansion.
# Blank values preserve defaults, Terraform discovery, and secure password prompts.
BANK_NAME='Risk E Bank'
BANK_BASE_URL=https://hr.bank.darkedges.com
BANK_COOKIE_SECURE=true
BANK_HR_CLAIM=roles
BANK_TOKEN_DEBUG_ENABLED=false
PASSPORT_ISSUER=https://issuer.zkp.au

# Database: reuse your existing database password; blank prompts securely.
BANK_DATABASE_PORT=15432
BANK_DATABASE_USER=bank
BANK_DATABASE_PASSWORD=
# Optional complete JDBC URL overrides the port setting.
BANK_DATABASE_URL=
BANK_DOCKER_SUBNET=10.243.0.0/24

# HR OIDC: blank values are discovered from the applied Terraform project.
BANK_OIDC_CLIENT_ID=
BANK_OIDC_ISSUER=
BANK_OIDC_CLIENT_SECRET=
BANK_TERRAFORM_DIR=

# Mailgun: enable after setting the SMTP login and sender. Blank password prompts.
BANK_MAIL_ENABLED=false
BANK_SMTP_HOST=smtp.mailgun.org
BANK_SMTP_PORT=587
BANK_SMTP_USERNAME=
BANK_SMTP_PASSWORD=
BANK_MAIL_FROM=

# Java and tool overrides (optional; JAVA_HOME must point to JDK 21+).
JAVA_HOME=
BANK_JAVA=
BANK_MVN=
BANK_MAVEN_REPO=
BANK_ADB=
ANDROID_HOME=
ANDROID_SDK_ROOT=

# Existing keys/runtime location defaults remain unchanged.
BANK_SECRET_DIR=
BANK_PRIVATE_JWK_FILE=
PASSPORT_PUBLIC_JWK_FILE=
PASSPORT_KEY_ID=
BANK_RUNTIME_DIR=
BANK_JAR=

# Journey API for Authr (/api/journey/v1). Off while BANK_JOURNEY_ISSUER is blank. The values come from the authstack repo's
# terraform/risk-e-bank outputs (bank_env).
BANK_JOURNEY_ISSUER=
BANK_JOURNEY_AUDIENCE=
BANK_JOURNEY_SCOPE=
BANK_JOURNEY_CLIENTS=
# Where invitation links send applicants: portal (default) or authr, at BANK_APPLICANT_ENTRY_URL.
BANK_APPLICANT_ENTRY=
BANK_APPLICANT_ENTRY_URL=
