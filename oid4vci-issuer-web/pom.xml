<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.darkedges.oid4vci</groupId>
    <artifactId>oid4vci-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>oid4vci-issuer-web</artifactId>
  <packaging>jar</packaging>

  <name>OpenID4VCI Issuer Web</name>
  <description>Plain Spring MVC controllers over oid4vci-issuer-core: Issuer Metadata, Credential Offer
    (by-reference fetch only), Token, Nonce, Credential, and JWKS endpoints. No custom
    AuthenticationProvider/filter/AbstractHttpConfigurer -- unlike OpenID4VP, none of these endpoints need
    a novel authentication mechanism; the Credential Endpoint's bearer-token check is an ordinary
    oauth2ResourceServer() concern, left to the consuming application's own SecurityFilterChain. See the
    project README.</description>

  <dependencies>
    <dependency>
      <groupId>com.darkedges.oid4vci</groupId>
      <artifactId>oid4vci-issuer-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
    </dependency>
    <!-- org.springframework.security.oauth2.jwt.Jwt itself lives here, not in
         spring-security-oauth2-resource-server (which has the resource-server filter/config machinery). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>com.darkedges.oid4vci</groupId>
      <artifactId>oid4vci-test-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
