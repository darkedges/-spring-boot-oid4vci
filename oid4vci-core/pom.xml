    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.darkedges.oid4vci</groupId>
      <artifactId>oid4vci-test-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
