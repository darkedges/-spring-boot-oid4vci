  <artifactId>oid4vci-core</artifactId>
  <packaging>jar</packaging>

  <name>OpenID4VCI Core</name>
  <description>Format-agnostic OID4VCI 1.0 protocol model: Credential Offer, Credential Issuer Metadata,
